# Ezt a fájlt NE töltsd fel Gitbe valódi értékekkel.
# Másold át erre a névre:
# supabase/functions/.env.lead-notification.local

RESEND_API_KEY=re_csereld_ki_valodi_kulcsra

# Legalább 32 véletlen bájtból álló titok.
# Ugyanezt add meg a Supabase Database Webhook
# x-webhook-secret fejlécében.
LEAD_WEBHOOK_SECRET=csereld_ki_hosszu_veletlen_titokra

# A feladó domainjét előbb hitelesíteni kell Resendben.
LEAD_NOTIFICATION_FROM=PandaDesign <ertesites@pandadesign.hu>

# Opcionális. Üresen hagyva a site_settings tábla
# contact_recipient_email, majd email mezője lesz a címzett.
# Több címzett vesszővel vagy pontosvesszővel választható el.
LEAD_NOTIFICATION_TO=

# true esetén az érdeklődő is kap visszaigazolást.
LEAD_AUTOREPLY_ENABLED=false
LEAD_AUTOREPLY_FROM=PandaDesign <hello@pandadesign.hu>

PUBLIC_SITE_URL=https://pandadesign.hu
